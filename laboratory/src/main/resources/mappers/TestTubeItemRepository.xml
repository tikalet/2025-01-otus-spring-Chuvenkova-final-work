<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.TestTubeItemRepository">

    <resultMap id="TestTubeItemMap" type="ru.otus.laboratory.model.TestTubeItem">
        <id property="id" column="ID"/>
        <result property="name" column="name"/>
    </resultMap>

    <select id="findAll" resultMap="TestTubeItemMap">
        SELECT id, name
        FROM test_tube_item
    </select>

    <select id="findById" resultMap="TestTubeItemMap">
        SELECT ti.id,
        ti.name
        FROM test_tube_item ti
        WHERE ti.id = #{id}
    </select>
</mapper>
