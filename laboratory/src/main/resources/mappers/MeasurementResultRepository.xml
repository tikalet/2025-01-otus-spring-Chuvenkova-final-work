<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.MeasurementResultRepository">

    <resultMap id="MeasurementResultMap" type="ru.otus.laboratory.model.MeasurementResult">
        <id property="id" column="ID"/>
        <result property="testResultId" column="test_result_id"/>
        <result property="measurementItemId" column="measurement_item_id"/>
        <result property="value" column="value"/>
        <result property="measurTime" column="measur_time"/>
        <result property="analyzerId" column="analyzer_id"/>
        <result property="patientId" column="patient_id"/>
    </resultMap>

    <insert id="create" keyColumn="id" keyProperty="id" parameterType="ru.otus.laboratory.model.MeasurementResult">
        <selectKey keyProperty="id" resultType="java.lang.Long" order="BEFORE">
            SELECT nextval('measurement_result_seq')
        </selectKey>
        INSERT INTO measurement_result (id, test_result_id, patient_id, measurement_item_id, value, measur_time,
        analyzer_id)
        VALUES(#{id}, #{testResultId}, #{patientId}, #{measurementItemId}, #{value}, #{measurTime}, #{analyzerId})
    </insert>

</mapper>