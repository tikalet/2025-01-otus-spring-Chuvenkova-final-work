<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.TestTubeResultRepository">

    <resultMap id="TestTubeResultMap" type="ru.otus.laboratory.model.TestTubeResult">
        <id property="id" column="ID"/>
        <result property="barcode" column="barcode"/>
        <result property="statusId" column="status_Id"/>
        <result property="testTubeItemId" column="test_tube_item_id"/>
        <result property="testTubeErrorId" column="test_tube_error_id"/>
    </resultMap>

    <insert id="create" keyColumn="id" keyProperty="id" parameterType="ru.otus.laboratory.model.TestTubeResult">
        <selectKey keyProperty="id" resultType="java.lang.Long" order="BEFORE">
            SELECT nextval('test_tube_result_seq')
        </selectKey>
        INSERT INTO test_tube_result (id, barcode, test_tube_item_id, status_id, test_tube_error_id)
        VALUES(#{id}, #{barcode}, #{testTubeItemId}, #{statusId}, #{testTubeErrorId})
    </insert>

</mapper>
