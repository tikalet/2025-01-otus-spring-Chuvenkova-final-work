<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.StaffRepository">

    <resultMap id="StaffMap" type="ru.otus.laboratory.model.Staff">
        <id property="id" column="ID"/>
        <result property="firstName" column="first_name"/>
        <result property="middleName" column="mid_name"/>
        <result property="lastName" column="last_name"/>
    </resultMap>

    <select id="findById" resultMap="StaffMap">
        SELECT id, first_name, mid_name, last_name
        FROM staff
        WHERE id = #{id}
    </select>


    <resultMap id="StaffAuthMap" type="ru.otus.laboratory.model.StaffAuth">
        <id property="staffId" column="staff_id"/>
        <result property="login" column="login"/>
        <result property="password" column="password"/>
        <collection property="authorityList" resultMap="AuthorityMap" ofType="ru.otus.laboratory.model.Authority"
                    columnPrefix="au_"/>
    </resultMap>

    <resultMap id="AuthorityMap" type="ru.otus.laboratory.model.Authority">
        <id property="id" column="ID"/>
        <result property="authority" column="authority"/>
    </resultMap>

    <select id="findByLogin" resultMap="StaffAuthMap">
        SELECT sa.staff_id ,
        sa.login ,
        sa.PASSWORD,
        a.id AS au_id,
        a.authority AS au_authority
        FROM staff_auth sa
        LEFT JOIN staff_authority_link sal ON sal.staff_id = sa.staff_id
        LEFT JOIN authorities a ON sal.authority_id = a.id
        WHERE sa.login = #{login}
    </select>


</mapper>
