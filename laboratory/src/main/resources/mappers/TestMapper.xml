<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.TestRepository">

    <resultMap id="LongWrapMap" type="ru.otus.laboratory.model.LongWrap">
        <id property="value" column="value"/>
    </resultMap>

    <resultMap id="TestItemMap" type="ru.otus.laboratory.model.TestItem">
        <id property="id" column="ID"/>
        <result property="name" column="name"/>
        <result property="price" column="price"/>
        <result property="testTubeId" column="test_tube_id"/>
    </resultMap>

    <resultMap id="TestResultMap" type="ru.otus.laboratory.model.TestResult">
        <id property="id" column="ID"/>
        <result property="price" column="price"/>
        <result property="testTubeId" column="test_tube_id"/>
        <result property="orderResultId" column="order_result_id"/>
        <result property="staffId" column="staff_id"/>
        <result property="statusId" column="status_Id"/>
    </resultMap>

    <select id="findAll" resultMap="TestItemMap">
        SELECT id, name, price
        FROM test_item
    </select>

    <select id="findByIds" resultMap="TestItemMap">
        SELECT ti.id,
        ti.name,
        ti.price,
        link.tube_item_id AS tube_value
        FROM test_item ti
        INNER JOIN test_item_test_tube_item_link link ON link.test_item_id = ti.id
        where ti.id IN
        <foreach collection="idList" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>

    <insert id="createResult" keyColumn="id" keyProperty="id" parameterType="ru.otus.laboratory.model.TestResult">
        <selectKey keyProperty="id" resultType="java.lang.Long" order="BEFORE">
            SELECT nextval('test_result_seq')
        </selectKey>
        INSERT INTO public.test_result (id, price, test_item_id, order_result_id, status_id, staff_id)
        VALUES(#{id}, #{price}, #{testItemId}, #{orderResultId}, #{statusId}, #{staffId})
    </insert>
</mapper>
