<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.StaffRepository">

    <resultMap id="StaffMap" type="ru.otus.laboratory.model.Staff">
        <id property="id" column="ID"/>
        <result property="firstName" column="first_name"/>
        <result property="middleName" column="mid_name"/>
        <result property="lastName" column="last_name"/>
    </resultMap>

    <select id="findById" resultMap="StaffMap">
        SELECT id, first_name, mid_name, last_name
        FROM staff
        WHERE id = #{id}
    </select>

</mapper>
