<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="ru.otus.laboratory.repository.OrderRepository">

    <resultMap id="OrderResultMap" type="ru.otus.laboratory.model.OrderResult">
        <id property="id" column="ID"/>
        <result property="price" column="price"/>
        <result property="statusId" column="status_Id"/>
        <result property="paymentTime" column="payment_time"/>
        <result property="staffId" column="staff_id"/>
        <result property="patientId" column="patient_id"/>
    </resultMap>

    <insert id="create" keyColumn="id" keyProperty="id" parameterType="ru.otus.laboratory.model.OrderResult">
        <selectKey keyProperty="id" resultType="java.lang.Long" order="BEFORE">
            SELECT nextval('order_result_seq')
        </selectKey>
        INSERT INTO public.order_result (id, total_price, status_id, payment_time, staff_id, patient_id)
        VALUES(#{id}, #{price}, #{statusId}, #{paymentTime}, #{staffId}, #{patientId})
    </insert>

</mapper>
